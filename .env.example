# forge-bot configuration
# Copy to .env and fill in values

# === Required ===
FORGE_INSTANCE_URL=https://gitea.example.com
FORGE_API_TOKEN=your-bot-api-token
FORGE_WEBHOOK_SECRET=your-webhook-secret
LLM_API_KEY=sk-your-key

# === LLM ===
# LLM_BASE_URL=https://api.openai.com/v1    # Or http://ollama:11434/v1
# LLM_MODEL=gpt-4o
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT=120
# LLM_MAX_CONCURRENT=3
# LLM_CONTEXT_WINDOW=8192        # Match your model's context window size
# LLM_TOOL_MODE=auto              # 'native', 'prompt', or 'auto'

# === Sandbox ===
# SANDBOX_ENABLED=true
# SANDBOX_TIMEOUT=60
# SANDBOX_MEMORY=512m
# SANDBOX_CPUS=1.0
# SANDBOX_PREPULL_IMAGES=python,node     # "all", "none", or comma-separated keys
# SANDBOX_IMAGES_FILE=                   # Path to custom sandbox-images.json override

# === RAG (optional) ===
# RAG_ENABLED=false
# RAG_EMBED_MODEL=all-MiniLM-L6-v2
# RAG_EMBED_URL=                         # OpenAI-compatible embedding endpoint (empty = local)
# RAG_CHUNK_SIZE=1500
# RAG_CHUNK_OVERLAP=200
# RAG_TOP_K=10
# RAG_MAX_CONTEXT_TOKENS=4000
# RAG_STORE_PATH=/data/chromadb

# === General ===
# WEBHOOK_PORT=8080
# LOG_LEVEL=INFO
# BOT_COMMAND_PREFIX=/
